ROADVISION_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters

DJANGO_ALLOWED_HOSTS=roadvision.example.gov.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://roadvision.example.gov.ph
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
DJANGO_CACHE_TABLE=roadvision_cache

# Credentials from the separate Coolify MariaDB 10.11 resource.
MYSQL_DATABASE=roadvision
MYSQL_USER=roadvision
MYSQL_PASSWORD=replace-with-the-database-password
MYSQL_HOST=replace-with-the-database-internal-hostname
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60

# Use a private AWS S3 or S3-compatible bucket for uploaded and processed media.
AWS_STORAGE_BUCKET_NAME=roadvision-media
AWS_S3_REGION_NAME=ap-southeast-1
# Leave blank for AWS S3. Set this for providers such as MinIO or Cloudflare R2.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-restricted-access-key
AWS_SECRET_ACCESS_KEY=replace-with-restricted-secret-key
AWS_QUERYSTRING_EXPIRE=900

# The bundled active model is a validated object-detection model.
ALLOW_DETECTION_MODE=true
AUTO_REGISTER_BUNDLED_MODEL=true
MODEL_MIN_MAP50=0.50
MODEL_REQUIRE_LOCAL_EVALUATION=true

# Enable only when the worker must connect to trusted private RTSP/HTTP cameras.
ALLOW_PRIVATE_STREAMS=false
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=3
ANALYSIS_POLL_INTERVAL=2
AUTO_START_ANALYSIS_WORKER=false

GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
LOG_LEVEL=INFO
