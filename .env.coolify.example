# Coolify generates the Django and MariaDB passwords referenced by
# SERVICE_REALBASE64_64_DJANGO, SERVICE_PASSWORD_64_DBUSER, and
# SERVICE_PASSWORD_64_DBROOT in docker-compose.coolify.yml.

DJANGO_ALLOWED_HOSTS=roadvision.example.gov.ph
DJANGO_CSRF_TRUSTED_ORIGINS=https://roadvision.example.gov.ph

# Use a private AWS S3 or S3-compatible bucket for uploaded and processed media.
AWS_STORAGE_BUCKET_NAME=roadvision-media
AWS_S3_REGION_NAME=ap-southeast-1
# Leave blank for AWS S3. Set this for providers such as MinIO or Cloudflare R2.
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-restricted-access-key
AWS_SECRET_ACCESS_KEY=replace-with-restricted-secret-key
AWS_QUERYSTRING_EXPIRE=900

# The bundled active model is a validated object-detection model.
ALLOW_DETECTION_MODE=true
MODEL_MIN_MAP50=0.50
MODEL_REQUIRE_LOCAL_EVALUATION=true

# Enable only when the worker must connect to trusted private RTSP/HTTP cameras.
ALLOW_PRIVATE_STREAMS=false

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
