ROADVISION_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=roadsense.example.gov.ph,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://roadsense.example.gov.ph
DJANGO_SECURE_COOKIES=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_HSTS_PRELOAD=false
DJANGO_CACHE_TABLE=roadvision_cache

MYSQL_DATABASE=roadsense
MYSQL_USER=roadsense_app
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_HOST=replace-with-the-database-internal-hostname
MYSQL_PORT=3306

# Set true only when the worker must connect to trusted private RTSP cameras.
ALLOW_PRIVATE_STREAMS=false
ANALYSIS_LEASE_SECONDS=300
ANALYSIS_MAX_ATTEMPTS=3
LIVE_PREVIEW_INTERVAL_SECONDS=1
CONTINUOUS_STREAM_RECONNECT_SECONDS=2

DATASET_MIN_TRAIN_IMAGES=50
DATASET_MIN_VAL_IMAGES=10
DATASET_MIN_TEST_IMAGES=10
MODEL_MIN_MAP50=0.50
MODEL_REQUIRE_LOCAL_EVALUATION=true
# The currently bundled potholenet-v1 artifact is an object-detection model.
ALLOW_DETECTION_MODE=true
DETECTION_MASK_REFINEMENT=false
DETECTION_MASK_MAX_SIZE=192
MODEL_MIN_LOCAL_TEST_IMAGES=10
AUTO_LABEL_CONFIDENCE=0.25
AUTO_LABEL_IOU=0.45
AUTO_TRAIN_MODEL=yolo11s-seg
AUTO_TRAIN_EPOCHS=100
AUTO_TRAIN_BATCH_SIZE=16
AUTO_TRAIN_IMAGE_SIZE=512
AUTO_TRAIN_DEVICE=cpu
# The Nixpacks startup script launches the durable worker explicitly.
AUTO_START_ANALYSIS_WORKER=false

# Required for durable Nixpacks media unless /app/media has a persistent volume.
AWS_STORAGE_BUCKET_NAME=roadvision-media
AWS_S3_REGION_NAME=ap-southeast-1
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=replace-with-restricted-access-key
AWS_SECRET_ACCESS_KEY=replace-with-restricted-secret-key
AWS_QUERYSTRING_EXPIRE=900
