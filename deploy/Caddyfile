{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8000} {
	root * {$FRONTEND_ROOT:frontend/dist}
	encode zstd gzip

	# Django owns JSON, protected downloads, health probes and its native admin.
	@backend path /api /api/* /media /media/* /_authenticated /_authenticated/* /django-admin /django-admin/* /static /static/* /health/ /healthz/ /livez/ /auth/ /logout/
	handle @backend {
		reverse_proxy {$DJANGO_UPSTREAM:127.0.0.1:8001}
	}

	# Missing bundles must return 404 instead of the React HTML shell.
	handle /assets/* {
		@existing file
		header @existing Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# React owns all page routes, including direct visits and hard refreshes.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
